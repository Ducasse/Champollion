Class {
	#name : 'CMethodScope',
	#superclass : 'Object',
	#instVars : [
		'receiver'
	],
	#category : 'Champollion2',
	#package : 'Champollion2'
}

{ #category : 'accessing' }
CMethodScope >> receiver [

	^ receiver
]

{ #category : 'accessing' }
CMethodScope >> receiver: anObject [

	receiver := anObject
]
